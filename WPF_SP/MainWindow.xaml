<Window x:Class="WPF_SP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPF_SP.Views"
        xmlns:vm="clr-namespace:WPF_SP.ViewModels"
        Title="SEM06-GARCIA" Height="860" Width="1360"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">

                    <TextBlock Text="GESTION EMPRESARIAL" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,10"/>

                    <Button Margin="0,3"
                            Command="{Binding NavegrarCommand}" CommandParameter="Categorias">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCategorias}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OneUIAccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Categorias" VerticalAlignment="Center"/>
                    </Button>

                    <Button Margin="0,3"
                            Command="{Binding NavegrarCommand}" CommandParameter="Proveedores">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProveedores}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OneUIAccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Proveedores" VerticalAlignment="Center"/>
                    </Button>

                    <Button Margin="0,3"
                            Command="{Binding NavegrarCommand}" CommandParameter="Productos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProductos}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OneUIAccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Productos" VerticalAlignment="Center"/>
                    </Button>

                    <Button Margin="0,3"
                            Command="{Binding NavegrarCommand}" CommandParameter="Pedidos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPedidos}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OneUIAccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Pedidos" VerticalAlignment="Center"/>
                    </Button>

                    <Separator Margin="0,14,0,14"/>

                    <TextBlock Text="ANALYTICS Y REPORTES" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,10"/>

                    <Button Margin="0,3"
                            Command="{Binding NavegrarCommand}" CommandParameter="Reportes">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowReportes}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OneUIAccentGradient}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Reporte de Ventas" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20"
                        Background="{StaticResource Surface2Brush}" CornerRadius="16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="EN LINEA" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <TextBlock Text="HYCROS\SQLEXPRESS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="BD: NeptunoDB" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12,8">
                <views:CategoriasView DataContext="{Binding Categorias}"
                    Visibility="{Binding DataContext.ShowCategorias,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ProveedoresView DataContext="{Binding Proveedores}"
                    Visibility="{Binding DataContext.ShowProveedores,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ProductosView DataContext="{Binding Productos}"
                    Visibility="{Binding DataContext.ShowProductos,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:PedidosView DataContext="{Binding Pedidos}"
                    Visibility="{Binding DataContext.ShowPedidos,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ReportesView DataContext="{Binding Reportes}"
                    Visibility="{Binding DataContext.ShowReportes,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
