<Window x:Class="WPF_SP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPF_SP.Views"
        xmlns:vm="clr-namespace:WPF_SP.ViewModels"
        Title="NeptunoDB · Sistema de Gestión" Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="12,20,12,0">
                    <TextBlock Text="MÓDULOS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,10"/>
                    <Button Margin="0,2"
                            Command="{Binding NavegrarCommand}" CommandParameter="Categorias">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowCategorias}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Categorías" VerticalAlignment="Center"/>
                    </Button>
                    <Button Margin="0,2"
                            Command="{Binding NavegrarCommand}" CommandParameter="Proveedores">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProveedores}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Proveedores" VerticalAlignment="Center"/>
                    </Button>
                    <Button Margin="0,2"
                            Command="{Binding NavegrarCommand}" CommandParameter="Productos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProductos}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Productos" VerticalAlignment="Center"/>
                    </Button>
                    <Button Margin="0,2"
                            Command="{Binding NavegrarCommand}" CommandParameter="Pedidos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPedidos}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Pedidos" VerticalAlignment="Center"/>
                    </Button>

                    <Separator Margin="4,12"/>

                    <TextBlock Text="REPORTES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,10"/>
                    <Button Margin="0,2"
                            Command="{Binding NavegrarCommand}" CommandParameter="Reportes">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowReportes}" Value="True">
                                        <Setter Property="Background" Value="#22C55E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Det. Pedidos" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="SQL Server · HYCROS\SQLEXPRESS" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="NeptunoDB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <views:CategoriasView DataContext="{Binding Categorias}"
                    Visibility="{Binding DataContext.ShowCategorias,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ProveedoresView DataContext="{Binding Proveedores}"
                    Visibility="{Binding DataContext.ShowProveedores,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ProductosView DataContext="{Binding Productos}"
                    Visibility="{Binding DataContext.ShowProductos,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:PedidosView DataContext="{Binding Pedidos}"
                    Visibility="{Binding DataContext.ShowPedidos,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
                <views:ReportesView DataContext="{Binding Reportes}"
                    Visibility="{Binding DataContext.ShowReportes,
                        RelativeSource={RelativeSource AncestorType=Window},
                        Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
