<UserControl x:Class="WPF_SP.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPF_SP.ViewModels">

    <Grid Margin="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,18">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                    HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,6">
                <TextBlock Text="MANTENIMIENTO DE CATALOGO" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBlock Text="Categorias" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Alta, edicion y baja logica de categorias de inventario" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="22,18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Nombre de Categoria *" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                             Text="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Descripcion" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}" MaxLength="200"
                             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="2,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}" MinWidth="120"
                            Content="Guardar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditarSeleccionadaCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Editar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelarEdicionCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Cancelar"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EliminarSeleccionadaCommand}"
                            Margin="10,0,0,0" MinWidth="120" Content="Baja Logica"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Categorias}"
                      SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"          Binding="{Binding CategoriaID}"     Width="65"/>
                    <DataGridTextColumn Header="NOMBRE"      Binding="{Binding NombreCategoria}" Width="240"/>
                    <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding Descripcion}"     Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
