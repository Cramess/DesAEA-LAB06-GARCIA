<UserControl x:Class="WPF_SP.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,18">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                    HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,6">
                <TextBlock Text="ANALYTICS &amp; AUDITORIA" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBlock Text="Reporte de Ventas" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Detalle de pedidos por intervalo de fechas (INNER JOIN Pedidos - DetallePedidos - Productos)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="22,18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="Fecha Inicial" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}" Width="170"
                                SelectedDate="{Binding FechaInicio}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="Fecha Final" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}" Width="170"
                                SelectedDate="{Binding FechaFin}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding GenerarReporteCommand}"
                        VerticalAlignment="Bottom" MinWidth="150"
                        Content="Generar Reporte"/>
                <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="22,18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="VENTAS TOTALES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}">
                        <TextBlock.Text>
                            <Binding Path="TotalVentas" StringFormat="S/. {0:N2}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="22,18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UNIDADES DESPACHADAS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Text="{Binding TotalUnidades, StringFormat='{}{0:N0}'}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="22,18">
                <StackPanel>
                    <TextBlock Text="LINEAS DE DETALLE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding TotalRegistros}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Detalles}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PEDIDO #"    Binding="{Binding PedidoID}"              Width="75"/>
                    <DataGridTextColumn Header="F. PEDIDO"   Binding="{Binding FechaPedido, StringFormat='dd/MM/yyyy'}"   Width="105"/>
                    <DataGridTextColumn Header="F. ENVIO"    Binding="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}"    Width="95"/>
                    <DataGridTextColumn Header="CLIENTE"     Binding="{Binding NombreCliente}"          Width="*"/>
                    <DataGridTextColumn Header="DESTINATARIO" Binding="{Binding Destinatario}"           Width="*"/>
                    <DataGridTextColumn Header="CIUDAD"      Binding="{Binding CiudadDestino}"          Width="100"/>
                    <DataGridTextColumn Header="PRODUCTO"    Binding="{Binding NombreProducto}"         Width="*"/>
                    <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding PrecioUnidad, StringFormat='S/. {0:N2}'}" Width="110"/>
                    <DataGridTextColumn Header="CANT."       Binding="{Binding Cantidad}"               Width="65"/>
                    <DataGridTextColumn Header="DESC. %"     Binding="{Binding Descuento, StringFormat='{}{0:P0}'}"        Width="75"/>
                    <DataGridTextColumn Header="SUBTOTAL"    Binding="{Binding SubTotal, StringFormat='S/. {0:N2}'}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
