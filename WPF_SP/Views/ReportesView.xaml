<UserControl x:Class="WPF_SP.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reporte de Detalle de Pedidos" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Detalle por intervalo de fechas (INNER JOIN Pedidos ↔ DetallePedidos ↔ Productos)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Fecha Inicio" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}" Width="160"
                                SelectedDate="{Binding FechaInicio}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Fecha Fin" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}" Width="160"
                                SelectedDate="{Binding FechaFin}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding GenerarReporteCommand}"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="Generar Reporte"/>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12"
              Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Ventas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}">
                        <TextBlock.Text>
                            <Binding Path="TotalVentas" StringFormat="S/. {0:N2}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Unidades" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Text="{Binding TotalUnidades, StringFormat='{}{0:N0}'}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Registros" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"
                               Text="{Binding TotalRegistros}"/>
                </StackPanel>
            </Border>
        </Grid>
        <DataGrid Grid.Row="3" Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding Detalles}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido #"    Binding="{Binding PedidoID}"             Width="70"/>
                <DataGridTextColumn Header="F. Pedido"   Binding="{Binding FechaPedido, StringFormat='dd/MM/yyyy'}"  Width="100"/>
                <DataGridTextColumn Header="F. Envío"    Binding="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}"   Width="90"/>
                <DataGridTextColumn Header="Cliente"     Binding="{Binding NombreCliente}"         Width="*"/>
                <DataGridTextColumn Header="Destinatario" Binding="{Binding Destinatario}"          Width="*"/>
                <DataGridTextColumn Header="Ciudad"      Binding="{Binding CiudadDestino}"         Width="100"/>
                <DataGridTextColumn Header="Producto"    Binding="{Binding NombreProducto}"        Width="*"/>
                <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnidad, StringFormat='S/. {0:N2}'}" Width="100"/>
                <DataGridTextColumn Header="Cant."       Binding="{Binding Cantidad}"              Width="60"/>
                <DataGridTextColumn Header="Desc. %"     Binding="{Binding Descuento, StringFormat='{}{0:P0}'}"       Width="75"/>
                <DataGridTextColumn Header="SubTotal"    Binding="{Binding SubTotal, StringFormat='S/. {0:N2}'}"      Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
