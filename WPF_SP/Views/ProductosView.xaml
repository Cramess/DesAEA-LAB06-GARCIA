<UserControl x:Class="WPF_SP.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Productos" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Mantenimiento de inventario de productos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Fila 1: Nombre, Categoría, Proveedor -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Nombre Producto *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="60"
                                 Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Categoría" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding CategoriaSeleccionada}"
                                  DisplayMemberPath="NombreCategoria"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proveedor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Proveedores}"
                                  SelectedItem="{Binding ProveedorSeleccionado}"
                                  DisplayMemberPath="CompaniaNombre"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Cant. x unidad, Precio, Existencias, Pedido, Reorden, Descontinuado -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Cant. x Unidad" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Precio Unit." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Existencia" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="En Pedido" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="Reorden" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <CheckBox Style="{StaticResource FlatCheckBox}"
                                  IsChecked="{Binding Descontinuado}" Content="Descontinuado"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="2,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}" MinWidth="110">
                        <TextBlock Text="Guardar"/>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditarSeleccionadoCommand}"
                            Margin="8,0,0,0" MinWidth="90">
                        <TextBlock Text="Editar"/>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelarEdicionCommand}" Margin="8,0,0,0">
                        <TextBlock Text="Cancelar"/>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EliminarSeleccionadoCommand}" Margin="8,0,0,0">
                        <TextBlock Text="Eliminar"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding Productos}"
                  SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding ProductoID}"           Width="50"/>
                <DataGridTextColumn Header="Producto"    Binding="{Binding NombreProducto}"        Width="*"/>
                <DataGridTextColumn Header="Categoría"   Binding="{Binding NombreCategoria}"       Width="130"/>
                <DataGridTextColumn Header="Proveedor"   Binding="{Binding NombreProveedor}"       Width="160"/>
                <DataGridTextColumn Header="Precio"      Binding="{Binding PrecioUnidad, StringFormat='S/. {0:N2}'}" Width="90"/>
                <DataGridTextColumn Header="Existencia"  Binding="{Binding UnidadesEnExistencia}"  Width="80"/>
                <DataGridTextColumn Header="En Pedido"   Binding="{Binding UnidadesEnPedido}"      Width="80"/>
                <DataGridTextColumn Header="Reorden"     Binding="{Binding NivelDeReorden}"        Width="70"/>
                <DataGridCheckBoxColumn Header="Desc."   Binding="{Binding Descontinuado}"         Width="55"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
