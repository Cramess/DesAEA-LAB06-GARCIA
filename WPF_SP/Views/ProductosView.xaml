<UserControl x:Class="WPF_SP.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,18">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                    HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,6">
                <TextBlock Text="INVENTARIO GENERAL" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBlock Text="Productos" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Control de existencias, precios y mantenimiento de stock" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="22,18" Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Nombre del Producto *" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="60"
                                 Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Categoria" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding CategoriaSeleccionada}"
                                  DisplayMemberPath="NombreCategoria"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proveedor" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Proveedores}"
                                  SelectedItem="{Binding ProveedorSeleccionado}"
                                  DisplayMemberPath="CompaniaNombre"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Cant. por Unidad" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Precio Unit. (S/.)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Existencias" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding UnidadesEnExistencia, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="En Pedido" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding UnidadesEnPedido, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="Nivel Reorden" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Margin="4,0,0,8">
                        <CheckBox Style="{StaticResource FlatCheckBox}"
                                  IsChecked="{Binding Descontinuado}" Content="Descontinuado"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="2,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}" MinWidth="120"
                            Content="Guardar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditarSeleccionadoCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Editar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelarEdicionCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Cancelar"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EliminarSeleccionadoCommand}"
                            Margin="10,0,0,0" MinWidth="120" Content="Baja Logica"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Productos}"
                      SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding ProductoID}"           Width="55"/>
                    <DataGridTextColumn Header="PRODUCTO"   Binding="{Binding NombreProducto}"       Width="*"/>
                    <DataGridTextColumn Header="CATEGORIA"  Binding="{Binding NombreCategoria}"      Width="140"/>
                    <DataGridTextColumn Header="PROVEEDOR"  Binding="{Binding NombreProveedor}"      Width="160"/>
                    <DataGridTextColumn Header="PRECIO"     Binding="{Binding PrecioUnidad, StringFormat='S/. {0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="STOCK"      Binding="{Binding UnidadesEnExistencia}" Width="75"/>
                    <DataGridTextColumn Header="PEDIDO"     Binding="{Binding UnidadesEnPedido}"     Width="75"/>
                    <DataGridTextColumn Header="REORDEN"    Binding="{Binding NivelDeReorden}"       Width="75"/>
                    <DataGridCheckBoxColumn Header="DESC."  Binding="{Binding Descontinuado}"        Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
