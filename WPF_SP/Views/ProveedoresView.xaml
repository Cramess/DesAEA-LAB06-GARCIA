<UserControl x:Class="WPF_SP.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Proveedores" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Mantenimiento y búsqueda de proveedores" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Nombre Contacto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FiltroBusquedaContacto, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Ciudad" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FiltroBusquedaCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding BuscarCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <TextBlock Text="Buscar"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource OutlineButton}" Command="{Binding LimpiarFiltrosCommand}"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="Limpiar"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Compañía *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="60"
                                 Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Contacto" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="40"
                                 Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cargo" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="40"
                                 Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Dirección" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="80"
                                 Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Ciudad" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="País" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Teléfono" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,5"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="24"
                                 Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="2,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}" MinWidth="110">
                        <TextBlock Text="Guardar"/>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditarSeleccionadoCommand}"
                            Margin="8,0,0,0" MinWidth="90">
                        <TextBlock Text="Editar"/>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelarEdicionCommand}" Margin="8,0,0,0">
                        <TextBlock Text="Cancelar"/>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EliminarSeleccionadoCommand}" Margin="8,0,0,0">
                        <TextBlock Text="Eliminar"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding Proveedores}"
                  SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding ProveedorID}"    Width="50"/>
                <DataGridTextColumn Header="Compañía"  Binding="{Binding CompaniaNombre}" Width="*"/>
                <DataGridTextColumn Header="Contacto"  Binding="{Binding NombreContacto}" Width="*"/>
                <DataGridTextColumn Header="Cargo"     Binding="{Binding CargoContacto}"  Width="*"/>
                <DataGridTextColumn Header="Ciudad"    Binding="{Binding Ciudad}"         Width="120"/>
                <DataGridTextColumn Header="País"      Binding="{Binding Pais}"           Width="100"/>
                <DataGridTextColumn Header="Teléfono"  Binding="{Binding Telefono}"       Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
