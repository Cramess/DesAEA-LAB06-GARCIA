<UserControl x:Class="WPF_SP.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,0,18">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8"
                    HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,6">
                <TextBlock Text="CADENA DE SUMINISTRO" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBlock Text="Proveedores" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Mantenimiento y busqueda de aliados comerciales" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Filtrar por Compania" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FiltroBusquedaCompania, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Nombre de Contacto" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FiltroBusquedaContacto, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Ciudad" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FiltroBusquedaCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource AccentButton}" Command="{Binding BuscarCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,10,0" MinWidth="110"
                        Content="Buscar"/>
                <Button Grid.Column="4" Style="{StaticResource OutlineButton}" Command="{Binding LimpiarFiltrosCommand}"
                        VerticalAlignment="Bottom" MinWidth="100"
                        Content="Limpiar"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="22,18" Margin="0,0,0,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Compania *" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="60"
                                 Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Contacto" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="40"
                                 Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cargo" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="40"
                                 Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Direccion" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="80"
                                 Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Ciudad" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Pais" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="30"
                                 Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Telefono" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}" MaxLength="24"
                                 Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="2,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibility}}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GuardarCommand}" MinWidth="120"
                            Content="Guardar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding EditarSeleccionadoCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Editar"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelarEdicionCommand}"
                            Margin="10,0,0,0" MinWidth="100" Content="Cancelar"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EliminarSeleccionadoCommand}"
                            Margin="10,0,0,0" MinWidth="120" Content="Baja Logica"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1" ClipToBounds="True">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Proveedores}"
                      SelectedItem="{Binding ProveedorSeleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding ProveedorID}"    Width="60"/>
                    <DataGridTextColumn Header="COMPANIA"  Binding="{Binding CompaniaNombre}" Width="200"/>
                    <DataGridTextColumn Header="CONTACTO"  Binding="{Binding NombreContacto}" Width="160"/>
                    <DataGridTextColumn Header="CARGO"     Binding="{Binding CargoContacto}"  Width="150"/>
                    <DataGridTextColumn Header="CIUDAD"    Binding="{Binding Ciudad}"         Width="120"/>
                    <DataGridTextColumn Header="PAIS"      Binding="{Binding Pais}"           Width="100"/>
                    <DataGridTextColumn Header="TELEFONO"  Binding="{Binding Telefono}"       Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
